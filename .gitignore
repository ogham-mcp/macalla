# Rust — cargo must be on PATH for the prek hooks; rustup installed with
# --no-modify-path, so add `. "$HOME/.cargo/env"` to your shell profile.
/target/
**/*.rs.bk
Cargo.lock.orig

# Node / Tauri UI
node_modules/
dist/
.vite/
apps/desktop/src-tauri/target/

# Models and weights — never committed
models/
*.gguf
*.onnx
*.bin
*.safetensors
*.mlmodelc/

# Recorded audio and local history
fixtures/audio/*.wav
!fixtures/audio/.gitkeep
*.sqlite
*.sqlite3
*.db

# Secrets and env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

docs/**/.DS_Store
.DS_Store

# Fixture audio is generated by fixtures/generate.sh, never committed.
fixtures/audio/

# Tier 1 bake-off working files
bench/*.log

# Competitor screenshots: reference only, never published (see scripts/publish.sh)

# Voice recordings: personal data. Never committed, never published.
# Transcripts go in bench/engine-fixtures.json instead.
*.mp3
*.m4a
*.wav
docs/sampletext-*.mp3

# Claude Code agent worktrees
.claude/worktrees/
