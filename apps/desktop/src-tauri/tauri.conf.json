{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macalla",
  "identifier": "dev.macalla.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Macalla",
        "width": 560,
        "height": 680,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Macalla",
        "width": 360,
        "height": 96,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "resizable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "26.0"
    }
  }
}
